@ResponseBody
@ExceptionHandler(HttpMessageNotReadableException.class)
public ResponseEntity<CRefError> handleHttpMessageNotReadableException(HttpMessageNotReadableException ex) {
    LOGGER.error("HttpMessageNotReadableException catched in handleHttpMessageNotReadableException", ex);

    CRefError cRefError = new CRefError();
    List<ErrorDetailsDTO> errorDetailDTOS = new ArrayList<>();
    HttpStatus httpStatus = BAD_REQUEST;
    cRefError.setStatus(httpStatus.value());
    cRefError.setErrors(errorDetailDTOS);

    String field = NOT_DEFINED;
    String label = ex.getMessage();

    Throwable cause = ex.getCause();
    if (cause instanceof MismatchedInputException) {   // InvalidFormatException en hérite
        MismatchedInputException mie = (MismatchedInputException) cause;
        try {
            field = buildPath(mie.getPath());
        } catch (Exception e) {
            LOGGER.warn("Cannot get field from exception");
        }
        if (cause instanceof InvalidFormatException) {
            Class<?> target = ((InvalidFormatException) cause).getTargetType();
            if (target != null && Number.class.isAssignableFrom(target)) {
                label = "Valeur numérique invalide";
            }
        }
    }

    ErrorDetailsDTO details = new ErrorDetailsDTO(label, NOT_DEFINED, field);
    errorDetailDTOS.add(details);

    LOGGER.error(BAD_REQUEST_ERROR_RESPONSE);
    return new ResponseEntity<>(cRefError, new HttpHeaders(), httpStatus);
}
