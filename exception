private ResponseEntity<Map<String, Object>> buildErrorResponse(String label, String code, String field) {
    Map<String, Object> error = new LinkedHashMap<>();
    error.put("label", label);
    error.put("code", code);
    error.put("field", field);

    Map<String, Object> body = new LinkedHashMap<>();
    body.put("status", 400);
    body.put("errors", Collections.singletonList(error));

    return ResponseEntity.badRequest().body(body);
}

@ExceptionHandler(HttpMessageNotReadableException.class)
public ResponseEntity<?> handleNotReadable(HttpMessageNotReadableException ex) {

    Throwable cause = ex.getCause();

    if (cause instanceof InvalidFormatException) {
        InvalidFormatException ife = (InvalidFormatException) cause;

        String field = buildPath(ife.getPath());
        String label = Number.class.isAssignableFrom(ife.getTargetType())
                ? "Valeur numérique invalide"
                : "Format invalide pour le champ " + field;

        return buildErrorResponse(label, "-", field);
    }

    if (cause instanceof MismatchedInputException) {
        MismatchedInputException mie = (MismatchedInputException) cause;
        return buildErrorResponse("Format JSON invalide", "-", buildPath(mie.getPath()));
    }

    // comportement existant pour les autres cas
    return /* ton code actuel */;
}
