public List<OffresBonusOutputDto> mapperEtEnrichir(List<TfRcOffresBonus> offresUniques) {
    if (offresUniques.isEmpty()) {
        return Collections.emptyList();
    }

    // 1. Extraire les codes offres
    List<String> codesOffres = offresUniques.stream()
            .map(TfRcOffresBonus::getCodeOffreBonus)
            .distinct()
            .collect(Collectors.toList());

    // 2. Récupérer toutes les lignes de jointure
    List<TfRcOffresBonus> toutesLesRelations = offresBonusRepo.findByCodeOffreBonusIn(codesOffres);

    // 3. Récupérer les entités PRODUIT
    List<String> tousLesCodesProduits = toutesLesRelations.stream()
            .map(TfRcOffresBonus::getCodeProduit) // Nom exact du champ dans Image 2
            .distinct()
            .collect(Collectors.toList());

    Map<String, TrRpProduit> mapProduitsRefs = productRepo.findByIdPolprodIn(tousLesCodesProduits).stream()
            .collect(Collectors.toMap(TrRpProduit::getIdPolprod, p -> p));

    // 4. Groupement des produits par Code Offre
    Map<String, List<TrRpProduit>> produitsParOffre = toutesLesRelations.stream()
            .filter(rel -> mapProduitsRefs.containsKey(rel.getCodeProduit()))
            .collect(Collectors.groupingBy(
                TfRcOffresBonus::getCodeOffreBonus,
                Collectors.mapping(
                    rel -> mapProduitsRefs.get(rel.getCodeProduit()), 
                    Collectors.toList()
                )
            ));

    // 5. Assemblage final vers le DTO
    return offresUniques.stream().map(offre -> {
        OffresBonusOutputDto dto = new OffresBonusOutputDto();
        dto.setCodeOffreBonus(offre.getCodeOffreBonus());
        // Ajoute ici tes autres setters (ex: dto.setMtMin(offre.getMtMin()))
        
        // On récupère la liste des produits pour cette offre
        List<TrRpProduit> produitsAssocies = produitsParOffre.getOrDefault(offre.getCodeOffreBonus(), new ArrayList<>());
        dto.setProduits(produitsAssocies);
        
        return dto;
    }).collect(Collectors.toList());
}
